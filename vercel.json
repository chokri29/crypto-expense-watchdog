{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/tatum/(.*)",
      "destination": "/api/tatum/[[...path]]"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/tatum/**/*.mjs": {
      "maxDuration": 60
    }
  }
}
