# Add this limit_req_zone directive inside the Nginx http {} context (outside server {}).
# Then place the server {} block below inside that same http {} context.
limit_req_zone $binary_remote_addr zone=walrus_upload:10m rate=2r/s;

server {
    listen 443 ssl http2;
    server_name walrus-publisher.example.com;

    ssl_certificate     /etc/letsencrypt/live/walrus-publisher.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/walrus-publisher.example.com/privkey.pem;

    client_max_body_size 256k;

    location = /v1/blobs {
        limit_except PUT { deny all; }
        limit_req zone=walrus_upload burst=6 nodelay;

        proxy_pass http://127.0.0.1:9001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 10s;
        proxy_send_timeout 45s;
        proxy_read_timeout 45s;
    }

    # Walrus documents the publisher API at /v1/api. This is a read-only
    # discovery endpoint used by the deployment check script.
    location = /v1/api {
        limit_except GET { deny all; }
        proxy_pass http://127.0.0.1:9001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    location / {
        return 404;
    }
}

# Do not add a permissive CORS policy. Ledger Memory sends uploads from its
# backend, and the publisher validates a short-lived one-use JWT on each PUT.
